# Cloudflare R2 (S3-compatible) storage for financial statement documents.
# Create an R2 bucket + API token in the Cloudflare dashboard, then fill these in
# locally (.env.local) and in your Vercel project's Environment Variables.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional: if the bucket is connected to a public custom domain, downloads use
# this base URL directly instead of generating short-lived signed links.
# e.g. https://documents.ridihydropower.com
R2_PUBLIC_URL=

# Password required to upload documents on the Annual/Quarterly Financial
# Statements pages. Choose a strong value — anyone with it can publish files.
DOCS_UPLOAD_PASSWORD=
